{
  "name": "banca-del-manana",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-content.mjs && tsc -b && vite build && node scripts/postbuild.mjs",
    "lint": "oxlint",
    "preview": "vite preview --port 4173",
    "ingest": "node scripts/ingest.mjs",
    "validate": "node scripts/validate-content.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build:fresh": "npm run ingest; npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
