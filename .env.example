# Copie a .env.local. Todas son PÚBLICAS (prefijo VITE_ = se incrustan en el frontend). Nunca ponga secretos aquí.
VITE_SITE_URL=https://banca-del-manana.pages.dev
# Correo público para el formulario de contacto (abre el cliente de correo del visitante)
VITE_CONTACT_EMAIL=
# Opcional: API de tipos de cambio sin clave (por defecto Frankfurter)
VITE_FX_API_URL=https://api.frankfurter.dev/v1/latest?base=USD
# Ruta base: "/" para Cloudflare/Vercel; "/banca-del-manana/" para GitHub Pages de proyecto
BASE_PATH=/
